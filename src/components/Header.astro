---
import { site } from '../site.config';
import { ph, waLink } from '../lib/ph';
import Icon from './Icon.astro';
import { withBase } from '../lib/base';

const wa = waLink(site.contact.whatsapp, site.headerCta.text);
---

<header class="site-header">
  <div class="site-header__bar gutter">
    <button class="site-header__menu" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu" aria-label="Open menu"><Icon name="menu" /><Icon name="close" /></button>
    <a class="brand" href={withBase('/')}><span set:html={ph(site.name)} /></a>
    <nav class="site-nav" id="site-menu" aria-label="Main">
      <ul class="site-nav__list">
        {site.nav.map((item) => (
          <li><a class="site-nav__link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="site-header__cta" href={wa} data-enquiry={site.headerCta.text}><Icon name="chat" /><span class="site-header__cta-label">{site.headerCta.label}</span></a>
  </div>
</header>
