---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SingheCollections from '../components/SingheCollections.astro';
import Rooms from '../components/Rooms.astro';
import Ready from '../components/Ready.astro';
import Build from '../components/Build.astro';
import MoreProducts from '../components/MoreProducts.astro';
import Details from '../components/Details.astro';
import Craft from '../components/Craft.astro';
import Visit from '../components/Visit.astro';
import { site } from '../site.config';
---

<Base title={`${site.name} — Design Concept`} description={site.description} home noindex>
  <Hero />
  <SingheCollections />
  <Rooms />
  <Ready />
  <Build />
  <MoreProducts />
  <Details />
  <Craft />
  <Visit />
</Base>
