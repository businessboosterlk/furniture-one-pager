---
import { site } from '../site.config';
import { ph } from '../lib/ph';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer gutter">
  <div class="site-footer__row">
    <p class="site-footer__brand" set:html={ph(site.name)} />
    <nav aria-label="Footer">
      <ul class="site-footer__nav">
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="site-footer__ig"><Icon name="instagram" /> <span set:html={ph(site.instagram)} /></p>
  </div>
  <p class="site-footer__legal">&copy; {year}{' '}<span set:html={ph(site.name)} /></p>
</footer>
