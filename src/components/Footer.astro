---
import { site } from '../site.config';
import { ph } from '../lib/ph';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer gutter">
  <div class="site-footer__row">
    <p class="site-footer__brand" set:html={ph(site.name)} />
    <nav aria-label="Footer">
      <ul class="site-footer__nav">
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    {!site.instagram.includes('[') && <p class="site-footer__ig"><Icon name="instagram" /> <a href={`https://www.instagram.com/${site.instagram.replace('@', '')}/`} target="_blank" rel="noopener noreferrer">{site.instagram}</a></p>}
  </div>
  <p class="site-footer__legal">&copy; {year}{' '}<span set:html={ph(site.name)} /> · Furniture concept preview. Generated imagery is illustrative, not a claim of stock or availability.</p>
</footer>
