---
// One icon component. The shapes come from src/data/icons.json, which scripts/build-icons.mjs writes from two licensed
// sets: Lucide for line icons, Simple Icons for brand marks. Never type path data here.
import icons from '../data/icons.json';
const { name } = Astro.props;
const brand = (icons.brand as Record<string, string>)[name];
const body = brand || (icons.line as Record<string, string>)[name];
if (!body) throw new Error(`Icon "${name}" is not in icons.json. Add it to scripts/build-icons.mjs, never draw it.`);
---
{brand
  ? <svg class="ic ic--brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" set:html={body} />
  : <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={body} />}
