---
// Section 5 (#build). Light, never a full configurator. Real radio buttons, so it works without JS; sections.js only
// moves the step bar, the summary line and the WhatsApp message. The weave close-up follows the fabric with CSS.
// No price is invented: the price prints as a placeholder and ticks when a choice changes.
import { build, site } from '../site.config';
import { ph } from '../lib/ph';
import Icon from './Icon.astro';
import { withBase } from '../lib/base';
const wa = site.contact.whatsapp === '94000000000' ? '' : `https://wa.me/${site.contact.whatsapp}`;
const first = `${build.presets[0].n} ${build.presets[0].name}`;
const text = `${build.sendIntro} Start: ${first}. Size: ${build.sizes[0]}. Fabric: ${build.fabrics[0].label}.`;
const href = '#enquiry';
---

<section class="build section" id="build" aria-labelledby="build-title" data-build data-wa={wa} data-intro={build.sendIntro}>
  <div class="gutter">
    <div class="sec-head">
      <p class="eyebrow">{build.eyebrow}</p>
      <h2 class="h2" id="build-title">{build.title}</h2>
      <p class="lede">{build.lede}</p>
    </div>
    <ol class="steps" aria-label="Four steps">
      {build.steps.map((s, i) => (
        <li data-step={i + 1} data-state={i === 0 ? 'now' : undefined}><span class="steps__n">{String(i + 1).padStart(2, '0')}</span> {s}</li>
      ))}
    </ol>
    <div class="build__grid">
      <figure class="build__drawing">
        <div class="build__sheet config-preview" data-preview data-row="1" data-col="1" data-preset="1" role="img" aria-label="Illustrative round-arm two-seat sofa in natural linen">
          {['round', 'slim', 'low'].map((name, i) => <img src={withBase(`/configurator/${name}.webp`)} width="3072" height="3072" data-preview-style={i+1} alt="" loading="lazy" />)}
        </div>
        <p class="preview-note">AI-generated design preview. Proportions, materials and availability must be confirmed before ordering.</p>
        <figcaption>
          <dl class="dims">
            {build.dims.map((d) => (
              <div><dt>{d.name}</dt><dd><span data-dimension={d.name} set:html={ph(d.name === 'Width' ? '1600' : d.value)} /> mm</dd></div>
            ))}
          </dl>
        </figcaption>
      </figure>
      <div class="build__controls">
        <fieldset class="group">
          <legend>{build.groupLabels.start}</legend>
          <div class="opts opts--presets">
            {build.presets.map((p, i) => (
              <label class="opt">
                <input type="radio" name="preset" value={i + 1} data-label={`${p.n} ${p.name}`} checked={i === 0} />
                <span class="opt__body"><span class="opt__n">{p.n}</span><span set:html={ph(p.name)} /></span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="group">
          <legend>{build.groupLabels.size}</legend>
          <div class="opts">
            {build.sizes.map((z, i) => (
              <label class="opt">
                <input type="radio" name="size" value={i + 1} data-label={z} checked={i === 0} />
                <span class="opt__body" set:html={ph(z)} />
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="group">
          <legend>{build.groupLabels.fabric}</legend>
          <div class="opts">
            {build.fabrics.map((f, i) => (
              <label class="opt">
                <input type="radio" name="fabric" value={i + 1} data-label={f.label} checked={i === 0} />
                <span class="opt__body" set:html={ph(f.label)} />
              </label>
            ))}
          </div>
          <p class="preview-note">Compare the fabric tones on your sofa preview. Request physical samples to confirm colour and feel.</p>
        </fieldset>
        <div class="build__send">
          <div class="price">
            <p class="price__n" data-price set:html={ph(build.price)} />
            <p class="price__note">{build.priceNote}</p>
          </div>
          <p class="build__sum" data-sum aria-live="polite" set:html={ph(`${first} · ${build.sizes[0]} · ${build.fabrics[0].label}`)} />
          <a class="btn btn--solid" data-send data-enquiry={text} href={href}><Icon name="chat" /> {build.send}</a>
          <div class="build-tools"><button class="btn btn--line" type="button" data-share-build>Copy design link</button><button class="text-btn" type="button" data-reset-build>Reset choices</button></div>
          <p class="preview-note" data-build-status role="status">Your design choices are saved on this device. No personal details are saved.</p>
        </div>
      </div>
    </div>
  </div>
</section>
