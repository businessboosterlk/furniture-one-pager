---
// Section 8 (#visit). Where and when, then two ways to talk: WhatsApp first, a call second. Links only, no form.
import { site } from '../site.config';
import Picture from './Picture.astro';
import Enquiry from './Enquiry.astro';
const connected = /^\+?\d{8,15}$/.test(site.contact.tel) && !site.contact.tel.includes('000000000');
const addressReady = !site.address.line1.includes('[');
---

<section class="visit section" id="visit" aria-labelledby="visit-title">
  <div class="visit__inner gutter">
    <div class="visit__copy">
      <p class="eyebrow">Visit Singhe</p>
      <h2 class="h2" id="visit-title">Some things are<br />better felt.</h2>
      <p class="lede">Feel the fabric. See the grain. Find your comfort. Visit the Moratuwa showroom, or explore Singhe’s Malabe and Colombo locations.</p>
      {addressReady && <p class="lede">{site.address.line1}, {site.address.city}<br />{site.hours}</p>}
      <div class="visit__doors">
        <a class="btn btn--solid" href="#enquiry">Prepare my enquiry</a>
        <a class="btn btn--line" href="https://singhefurniture.lk/contact-us/" target="_blank" rel="noopener noreferrer">All showrooms</a>
        {connected && <a class="btn btn--line" href={`tel:${site.contact.tel}`}>Call {site.contact.phoneLabel}</a>}
      </div>
    </div>
    <div class="visit__map"><Picture slot="room-1" alt="Illustrative living room with a timber sofa and coffee table" /></div>
  </div>
</section>
<Enquiry />
