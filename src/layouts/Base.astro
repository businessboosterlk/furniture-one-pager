---
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/hero.css';
import '../styles/sections.css';
import '../styles/complete.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import { withBase, STAGING } from '../lib/base';
const buildVersion = Date.now().toString(36);
const scriptUrl = (file: string) => `${withBase('/' + file)}?v=${buildVersion}`;

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  home?: boolean;
}
const { title, description = site.description, home = false } = Astro.props;
const noindex = Astro.props.noindex || STAGING;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = home ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.colours.paper} />
    <!-- Empty icon until the client sends a logo. Stops the browser asking for /favicon.ico and getting a 404. -->
    <link rel="icon" href="data:," />
    {!STAGING && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={withBase('/fonts/cormorant.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={withBase('/theme.css')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <script src={scriptUrl('site.js')} defer is:inline></script>
    {home && <script src={scriptUrl('hero.js')} defer is:inline></script>}
    {home && <script src={scriptUrl('sections.js')} defer is:inline></script>}
    {home && <script src={scriptUrl('complete.js')} defer is:inline></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
