---
import { withBase } from '../lib/base';
const products = [
  {id:'armchair',name:'The lounge chair',option:'Upholstery tone',choices:['Cream linen tone','Oatmeal tone','Charcoal tone']},
  {id:'dining',name:'The dining table',option:'Timber finish',choices:['Pale natural tone','Warm honey tone','Deep walnut tone']},
  {id:'bed',name:'The platform bed',option:'Timber finish',choices:['Pale natural tone','Warm honey tone','Deep walnut tone']},
  {id:'coffee-table',name:'The coffee table',option:'Timber finish',choices:['Pale natural tone','Warm honey tone','Deep walnut tone']}
];
---
<section class="section more-products gutter" id="more-designs" aria-labelledby="more-title">
  <div class="sec-head">
    <p class="eyebrow">Beyond the sofa</p>
    <h2 class="h2" id="more-title">Your home. Your character.</h2>
    <p class="lede">Explore a different finish. Start a conversation about a piece made for your space.</p>
  </div>
  <div class="more-products__grid">
    {products.map(product => <article class="finish-card" data-finish-card data-name={product.name}>
      <div class="finish-card__image" data-tone="0" role="img" aria-label={`Illustrative ${product.name.toLowerCase()}, ${product.choices[0]}`}>
        <img src={withBase(`/collection-v2/${product.id}.jpg`)} alt="" width="2172" height="724" loading="lazy" />
      </div>
      <div class="finish-card__body">
        <h3>{product.name}</h3>
        <fieldset><legend>{product.option}</legend>
          <div class="finish-card__options">{product.choices.map((choice,index)=>
            <label><input type="radio" name={`finish-${product.id}`} value={index} data-label={choice} checked={index===0}/><span>{choice}</span></label>
          )}</div>
        </fieldset>
        <p class="finish-card__selection" aria-live="polite">{product.choices[0]}</p>
        <a class="text-btn" href="#enquiry" data-finish-enquiry data-enquiry={`Please tell me about ${product.name.toLowerCase()} in ${product.choices[0]}. Please confirm available sizes, materials and pricing.`}>Enquire about this design</a>
      </div>
    </article>)}
  </div>
  <p class="preview-note">AI-generated concept previews, not stock photographs. Finish names describe appearance, not a verified wood species or fabric. Dimensions, materials and available options are confirmed on enquiry.</p>
</section>
